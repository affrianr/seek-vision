{
  "name": "@affrianr/seek-vision",
  "version": "1.0.0",
  "type": "module",
  "description": "Vision bridge for text-only models - extract structured image context using Gemini API or Antigravity CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "seek-vision": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm audit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "vision",
    "image",
    "ocr",
    "gemini",
    "antigravity",
    "ai",
    "llm",
    "deepseek"
  ],
  "author": "Tuan",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.15.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ]
}
